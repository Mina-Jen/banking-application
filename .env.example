# Copy to .env and fill in. .env is git-ignored; never commit a real secret.
# Generate the two required secrets with:  openssl rand -base64 48

# --- required, the stack refuses to start without these ---
MYSQL_ROOT_PASSWORD=change-me-root-password
BANKING_DB_PASSWORD=change-me-app-password
JWT_SECRET=replace-with-48-random-base64-chars

# --- database names / user ---
MYSQL_DATABASE=banking_db
BANKING_DB_USER=banking

# --- first admin account (optional; when ADMIN_PASSWORD is empty no admin is created) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- AI assistant (optional; unset means /api/... suggestion endpoints answer 503) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=

# --- host ports (backend defaults to 18080 because 8080 is usually busy) ---
BACKEND_HOST_PORT=18080
FRONTEND_HOST_PORT=3000
MYSQL_HOST_PORT=33060

# --- image names (optional) ---
# Uncomment to start published images instead of building locally:
#   docker compose pull && docker compose up --no-build
# BACKEND_IMAGE=ghcr.io/<owner>/<repo>/banking-backend:latest
# FRONTEND_IMAGE=ghcr.io/<owner>/<repo>/banking-frontend:latest
