          "401": {
            "description": "No valid access token",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionPageResponse"
                }
              }
            }
          },
          "404": {
            "description": "Account does not exist, or is not the caller's — a CUSTOMER gets the identical answer for both",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionPageResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid page or size",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionPageResponse"
                }
              }
            }
          },
          "429": {
            "description": "More than 60 requests in one minute for this user; Retry-After says how long to wait",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionPageResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TransferRequest": {
        "type": "object",
        "description": "Request body for a transfer between two accounts",
        "properties": {
          "sourceAccountNumber": {
            "type": "string",
            "description": "Account to take the money from",
            "example": "100001"
          },
          "destinationAccountNumber": {
            "type": "string",
            "description": "Account to put the money into",
            "example": "100002"
          },
          "amount": {
            "type": "string",
            "description": "Amount as a decimal string: greater than zero, at most two decimal places",
            "example": "2000.00"
          }
        }
      },
      "TransactionResponse": {
        "type": "object",
        "description": "One entry of an account's transaction history",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "reference": {
            "type": "string",
            "description": "Unique transaction reference",
            "example": "TXN-lz3k9x00a1b2"
          },
          "accountNumber": {
            "type": "string",
            "description": "Account number exactly as the request spelled it",
            "example": "100001"
          },
          "type": {
            "type": "string",
            "description": "DEPOSIT, WITHDRAW, TRANSFER_OUT (source side) or TRANSFER_IN (destination side)",
            "example": "TRANSFER_OUT"
          },
          "amount": {
            "type": "string",
            "description": "Moved amount as a decimal string",
            "example": "2000.00"
          },
          "balanceAfter": {
            "type": "string",
            "description": "Balance of the account AFTER this transaction",
            "example": "3500.00"
          },
          "referenceAccount": {
            "type": "string",
            "description": "Other account of a transfer, absent for deposit and withdraw",
            "example": "100002"
          },
          "createdAt": {
            "type": "string",
            "description": "When the transaction was recorded, ISO-8601",
            "example": "2026-10-21T17:05:00Z"
          }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "description": "Request body for registering a login",
        "properties": {
          "username": {
            "type": "string",
            "description": "3 to 50 characters: lowercase letters, digits, dot, underscore, hyphen",
            "example": "juan.dela"
          },
          "password": {
            "type": "string",
            "description": "8 to 72 characters",
            "example": "correct-horse-battery"
          }
        }
      },
      "RegisterResponse": {
        "type": "object",
        "description": "Confirmation of a registered login",
        "properties": {
          "username": {
            "type": "string",
            "example": "juan.dela"
          },
          "role": {
            "type": "string",
            "description": "Registrations always create this role",
            "example": "CUSTOMER"
          }
        }
      },
      "RefreshRequest": {
        "type": "object",
        "description": "Request body for refreshing an expired access token",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "The refresh token received at login"
          }
        }
      },
      "TokenResponse": {
        "type": "object",
        "description": "Token pair returned by login and refresh",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Send on every API call as 'Authorization: Bearer <accessToken>'"
          },
          "refreshToken": {
            "type": "string",
            "description": "Long-lived; send it to /api/auth/refresh when the access token expires"
          },
          "tokenType": {
            "type": "string",
            "description": "Token type for the Authorization header",
            "example": "Bearer"
          },
          "expiresInSeconds": {
            "type": "integer",
            "format": "int64",
            "description": "Access token lifetime in seconds",
            "example": 900
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "description": "Request body for logging in",
        "properties": {
          "username": {
            "type": "string",
            "example": "juan.dela"
          },
          "password": {
            "type": "string",
            "example": "correct-horse-battery"
          }
        }
      },
      "CreateAccountRequest": {
        "type": "object",
        "description": "Request body for opening an account. There is no account number: the bank assigns it.",
        "properties": {
          "accountName": {
            "type": "string",
            "description": "Account holder name, at most 100 characters",
            "example": "Juan Dela Cruz"
          },
          "initialDeposit": {
            "type": "string",
            "description": "Opening deposit as a decimal string; zero creates the account without a transaction",
            "example": "5000.00"
          }
        }
      },
      "AccountResponse": {
        "type": "object",
        "description": "A bank account",
        "properties": {
          "accountNumber": {
            "type": "string",
            "example": "100001"
          },
          "accountName": {
            "type": "string",
            "example": "Juan Dela Cruz"
          },
          "balance": {
            "type": "string",
            "description": "Balance in pesos with two decimal places",
            "example": "7000.00"
          },
          "createdAt": {
            "type": "string",
            "description": "When the account was created, ISO-8601",
            "example": "2026-10-21T17:00:00Z"
          }
        }
      },
      "AmountRequest": {
        "type": "object",
        "description": "Request body with a single amount",
        "properties": {
          "amount": {
            "type": "string",
            "description": "Amount as a decimal string: greater than zero, at most two decimal places",
            "example": "2000.00"
          }
        }
      },
      "CreateAccountWithNumberRequest": {
        "type": "object",
        "description": "Request body for an ADMIN opening an account with a chosen number",
        "properties": {
          "accountNumber": {
            "type": "string",
            "description": "Account number chosen by the operator, at most 20 characters",
            "example": "100001"
          },
          "accountName": {
            "type": "string",
            "description": "Account holder name, at most 100 characters",
            "example": "Juan Dela Cruz"
          },
          "initialDeposit": {
            "type": "string",
            "description": "Opening deposit as a decimal string; zero creates the account without a transaction",
            "example": "5000.00"
          }
        }
      },
      "AccountPageResponse": {
        "type": "object",
        "description": "One page of the accounts the caller may see, ordered by account number",
        "properties": {
          "accounts": {
            "type": "array",
            "description": "Accounts of this page",
            "items": {
              "$ref": "#/components/schemas/AccountResponse"
            }
          },
          "page": {
            "type": "integer",
            "format": "int32",
            "description": "Zero-based page number",
            "example": 0
          },
          "size": {
            "type": "integer",
            "format": "int32",
            "description": "Requested page size",
            "example": 20
          },
          "totalElements": {
            "type": "integer",
            "format": "int64",
            "description": "Total number of accounts for this caller",
            "example": 3
          },
          "totalPages": {
            "type": "integer",
            "format": "int32",
            "description": "Total number of pages",
            "example": 1
          }
        }
      },
      "TransactionPageResponse": {
        "type": "object",
        "description": "One page of an account's transaction history, oldest first",
        "properties": {
          "transactions": {
            "type": "array",
            "description": "Transactions of this page",
            "items": {
              "$ref": "#/components/schemas/TransactionResponse"
            }
          },
          "page": {
            "type": "integer",
            "format": "int32",
            "description": "Zero-based page number",
            "example": 0
          },
          "size": {
            "type": "integer",
            "format": "int32",
            "description": "Requested page size",
            "example": 20
          },
          "totalElements": {
            "type": "integer",
            "format": "int64",
            "description": "Total number of transactions for the account",
            "example": 42
          },
          "totalPages": {
            "type": "integer",
            "format": "int32",
            "description": "Total number of pages",
            "example": 3
          }
        }
      }
    }
  }
}
